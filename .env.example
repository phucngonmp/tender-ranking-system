# --- Database ---
POSTGRES_USER=tender
POSTGRES_PASSWORD=change_me
POSTGRES_DB=tender_ranking
DATABASE_URL=postgresql://tender:change_me@postgres:5432/tender_ranking?schema=public

# --- Redis / Queue ---
REDIS_URL=redis://redis:6379

# --- JWT ---
JWT_ACCESS_SECRET=change_me_access_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_REFRESH_EXPIRES_IN=7d

# --- OpenAI ---
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# --- Crawler worker ---
CRAWLER_WORKER_URL=http://crawler-worker:8000
# Public URL the crawler worker uses to call back into the backend
BACKEND_INTERNAL_URL=http://backend:3000
# Shared secret between backend and crawler-worker for /internal/* endpoints
INTERNAL_API_TOKEN=change_me_internal_token

# --- Backend ---
PORT=3000
NODE_ENV=production
MAX_CONCURRENT_CRAWLS=5

# --- Email digest (daily 8am top-tenders summary) ---
# Generic SMTP — works with Gmail Workspace, Office365, or a company mail server.
# Leave blank to disable sending (digest still runs, just logs a warning and skips).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Tender Ranking System
# Public URL of the frontend, used to build tender links inside digest emails
APP_PUBLIC_URL=http://localhost:8080

# --- Frontend (build-time) ---
VITE_API_BASE_URL=http://localhost:3000

# --- Seed admin (used by seed script, first run only) ---
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change_me_admin_password
